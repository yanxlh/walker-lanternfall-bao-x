 "excerpts": [
  {
   "beat_id": "B04",
   "path": "effects/defeat_sparks.tscn",
   "start_line": 19,
   "end_line": 32,
   "text": "material = SubResource(\"Material_additive\")\nemitting = false\namount = 16\ntexture = ExtResource(\"1_texture\")\nlifetime = 0.45\none_shot = true\npreprocess = 0.0\nexplosiveness = 1.0\nlocal_coords = false\nemission_shape = 0\ndirection = Vector2(1, 0)\nspread = 180.0\ngravity = Vector2(0, 12)\ninitial_velocity_min = 25.0"
  },
  {
   "beat_id": "B06",
   "path": "effects/particle_presentation.gd",
   "start_line": 47,
   "end_line": 57,
   "text": "func _on_weapon_hit(at: Vector2) -> void:\n\thits_seen += 1\n\tif session.state.current != GS.PLAYING or hit_bursts.size() >= MAX_HIT_BURSTS:\n\t\treturn\n\tvar burst := HitScene.instantiate() as CPUParticles2D\n\tadd_child(burst)\n\tburst.global_position = session.to_global(at)\n\thit_bursts.append(burst)\n\tburst.finished.connect(_on_hit_finished.bind(burst))\n\tburst.restart()\n\thits_spawned += 1"
  },
  {
   "beat_id": "B09",
   "path": "effects/defeat_sparks.tscn",
   "start_line": 36,
   "end_line": 39,
   "text": "scale_amount_min = 0.7\nscale_amount_max = 1.8\nscale_amount_curve = SubResource(\"Curve_scale\")\ncolor_ramp = SubResource(\"Gradient_color\")"
  },
  {
   "beat_id": "B11",
   "path": "effects/defeat_sparks.tscn",
   "start_line": 12,
   "end_line": 14,
   "text": "[sub_resource type=\"Gradient\" id=\"Gradient_color\"]\noffsets = PackedFloat32Array(0, 0.6, 1)\ncolors = PackedColorArray(1, 0.95, 0.65, 1, 1, 0.75, 0.3, 1, 0.65, 0.2, 0.05, 0)"
  },
  {
   "beat_id": "B13",
   "path": "effects/particle_presentation.gd",
   "start_line": 121,
   "end_line": 131,
   "text": "func _physics_process(delta: float) -> void:\n\tif not is_instance_valid(session) or not is_instance_valid(trail):\n\t\treturn\n\t_apply_policy()\n\tvar current: Vector2 = session.player.global_position\n\tvar distance: float = current.distance_to(previous_position) if have_position else 0.0\n\tvar teleport_limit: float = session.player.speed * delta * 2.0 + 4.0\n\ttrail.global_position = current + Vector2(0, 7)\n\ttrail.emitting = session.state.current == GS.PLAYING and trail.is_visible_in_tree() and distance > 0.01 and distance <= teleport_limit\n\tprevious_position = current\n\thave_position = true"
  },
  {
   "beat_id": "B15",
   "path": "effects/lantern_trail.tscn",
   "start_line": 17,
   "end_line": 29,
   "text": "z_index = 1\ntexture_filter = 1\nmaterial = SubResource(\"Material_additive\")\nemitting = false\namount = 24\ntexture = ExtResource(\"1_texture\")\nlifetime = 0.35\none_shot = false\npreprocess = 0.0\nexplosiveness = 0.0\nlocal_coords = false\nemission_shape = 1\nemission_sphere_radius = 3.0"
  },
  {
   "beat_id": "B17",
   "path": "effects/particle_presentation.gd",
   "start_line": 59,
   "end_line": 70,
   "text": "func _on_leveled_up(_level: int) -> void:\n\tlevels_seen += 1\n\tif session.state.current != GS.PLAYING or level_bursts.size() >= MAX_LEVEL_BURSTS:\n\t\treturn\n\tvar burst := LevelScene.instantiate() as CPUParticles2D\n\t_sync_overlay()\n\tlevel_overlay.add_child(burst)\n\tburst.position = session.hud.levelup_particle_anchor()\n\tlevel_bursts.append(burst)\n\tburst.finished.connect(_on_level_finished.bind(burst))\n\tburst.restart()\n\tlevels_spawned += 1"
  },
  {
   "beat_id": "B19",
   "path": "effects/particle_presentation.gd",
   "start_line": 107,
   "end_line": 119,
   "text": "func _apply_policy() -> void:\n\tif not is_instance_valid(session) or not is_instance_valid(trail):\n\t\treturn\n\tlevel_overlay.visible = is_visible_in_tree()\n\tvar playing: bool = session.state.current == GS.PLAYING\n\tfor burst in hit_bursts:\n\t\tburst.speed_scale = 1.0 if playing else 0.0\n\tfor burst in level_bursts:\n\t\t# The upgrade screen intentionally allows its celebration to finish.\n\t\tburst.speed_scale = 1.0 if session.state.current in [GS.PLAYING, GS.LEVELUP] else 0.0\n\ttrail.speed_scale = 1.0 if playing else 0.0\n\tif not playing or not trail.is_visible_in_tree():\n\t\ttrail.emitting = false"
  },
  {
   "beat_id": "B21",
   "path": "tests/test_particles_edges.gd",
   "start_line": 57,
   "end_line": 69,
   "text": "\t\tgame.player.position = Vector2(stall.x - 19.0 - Tuning.PLAYER_RADIUS, stall.y))\n\tawait frames(4)\n\tvar start: Vector2 = game.player.position\n\tkey(KEY_D)\n\tvar emitted := 0\n\tvar moved := 0.0\n\tfor i in 30:\n\t\tawait frames(1)\n\t\tmoved = maxf(moved, game.player.position.distance_to(start))\n\t\temitted += 1 if game.particles.trail.emitting else 0\n\tkey(KEY_D, false)\n\tcheck(\"blocked-input-held-no-displacement\", moved < 0.01, {\"moved\": moved})\n\tcheck(\"blocked-push-never-emits\", emitted == 0, {\"emitting_frames\": emitted})"
  },
  {
   "beat_id": "B23",
   "path": "shaders/particles_generated.gdshader",
   "start_line": 148,
   "end_line": 161,
   "text": "\tfloat pi = 3.14159;\n\tparams.scale = vec3(mix(scale_min, scale_max, rand_from_seed(alt_seed)));\n\tparams.scale = sign(params.scale) * max(abs(params.scale), 0.001);\n\tparams.hue_rotation = pi * 2.0 * mix(hue_variation_min, hue_variation_max, rand_from_seed(alt_seed));\n\tparams.animation_speed = mix(anim_speed_min, anim_speed_max, rand_from_seed(alt_seed));\n\tparams.animation_offset = mix(anim_offset_min, anim_offset_max, rand_from_seed(alt_seed));\n\tparams.lifetime = (1.0 - lifetime_randomness * rand_from_seed(alt_seed));\n\tparams.color = color_value;\n}\n\nvoid process_display_param(inout DisplayParameters parameters, float lifetime) {\n\t// Compile-time add textures.\n\tparameters.scale *= texture(scale_curve, vec2(lifetime)).rgb;\n\tparameters.color *= texture(color_ramp, vec2(lifetime));"
  },
  {
   "beat_id": "B25",
   "path": "tests/cost_effects.gd",
   "start_line": 58,
   "end_line": 63,
   "text": "\tgame = Session.new()\n\tgame.test_no_spawn = true\n\troot.add_child(game)\n\tif not effects:\n\t\tgame.particles.free()\n\tgame.run_started.connect(_fixture.bind(cond), CONNECT_ONE_SHOT)"
  }
