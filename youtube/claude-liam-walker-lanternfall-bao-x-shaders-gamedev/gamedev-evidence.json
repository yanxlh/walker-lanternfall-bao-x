 "components": [
  {
   "id": "hurt-tint",
   "explanation": "The 2D shader from code: Bao's nine-line canvas_item shader mixes the incoming COLOR toward hurt_color by hurt_amount; the read-only driver, added by the session, gives the courier his own ShaderMaterial and writes clamp(iframes / 48) every frame in PLAYING, PAUSED and LEVELUP and 0 otherwise. The counter is player.iframes, set to IFRAME_TICKS (48) on an accepted hit and decremented once per simulation tick.",
   "beat_ids": [
    "B05",
    "B06",
    "B07",
    "B08"
