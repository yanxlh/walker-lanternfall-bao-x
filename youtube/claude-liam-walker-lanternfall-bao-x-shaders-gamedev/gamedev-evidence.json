  {
   "beat_id": "B05",
   "path": "shaders/hurt_tint.gdshader",
   "start_line": 1,
   "end_line": 9,
   "text": "shader_type canvas_item;\nrender_mode unshaded;\n\nuniform float hurt_amount : hint_range(0.0, 1.0) = 0.0;\nuniform vec4 hurt_color : source_color = vec4(1.0, 1.0, 0.0, 1.0);\n\nvoid fragment() {\n\tCOLOR.rgb = mix(COLOR.rgb, hurt_color.rgb, hurt_amount);\n}"
  },
  {
   "beat_id": "B07",
   "path": "effects/hurt_tint_presentation.gd",
   "start_line": 18,
   "end_line": 30,
   "text": "\tgame.state.changed.connect(func(_from: int, _to: int): refresh())\n\trefresh()\n\nfunc _process(_delta: float) -> void:\n\trefresh()\n\nfunc amount() -> float:\n\tif session.state.current in [GS.PLAYING, GS.PAUSED, GS.LEVELUP]:\n\t\treturn clampf(float(session.player.iframes) / Tuning.IFRAME_TICKS, 0.0, 1.0)\n\treturn 0.0\n\nfunc refresh() -> void:\n\tmaterial.set_shader_parameter(\"hurt_amount\", amount())"
  },
  {
   "beat_id": "B09",
   "path": "a5/material_room.tscn",
   "start_line": 7,
   "end_line": 18,
   "text": "[sub_resource type=\"PlaneMesh\" id=\"PlaneMesh_floor\"]\nsize = Vector2(8, 8)\n\n[node name=\"LanternGateRoom\" instance=ExtResource(\"1_room\")]\n\n[node name=\"Mesh\" parent=\"Floor\"]\ntransform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, 0)\nmaterial_override = ExtResource(\"2_floor\")\nmesh = SubResource(\"PlaneMesh_floor\")\n\n[node name=\"Mesh\" parent=\"StandIn\"]\nmaterial_override = ExtResource(\"3_standin\")"
  },
  {
   "beat_id": "B11",
   "path": "a5/materials/cobblestone_warm_floor.tres",
   "start_line": 8,
   "end_line": 18,
   "text": "[resource]\nrender_priority = 0\nshader = ExtResource(\"1_1ervd\")\nshader_parameter/color_tex = ExtResource(\"2_60gv5\")\nshader_parameter/normal_tex = ExtResource(\"3_ovpgk\")\nshader_parameter/roughness_tex = ExtResource(\"4_obb43\")\nshader_parameter/tint = Color(1, 0.92, 0.8, 1)\nshader_parameter/uv_scale = 2.0\nshader_parameter/roughness_min = 0.55\nshader_parameter/roughness_max = 0.95\nshader_parameter/normal_strength = 1.0"
  },
  {
   "beat_id": "B13",
   "path": "shaders/cobblestone_surface.gdshader",
   "start_line": 17,
   "end_line": 24,
   "text": "void fragment() {\n\tvec2 uv = UV * uv_scale;\n\tALBEDO = texture(color_tex, uv).rgb * tint.rgb;\n\tROUGHNESS = mix(roughness_min, roughness_max, texture(roughness_tex, uv).r);\n\tNORMAL_MAP = texture(normal_tex, uv).rgb;\n\tNORMAL_MAP_DEPTH = normal_strength * mix(0.5, 1.0, abs(normalize(NORMAL).z));\n\tMETALLIC = 0.0;\n}"
  },
  {
   "beat_id": "B15",
   "path": "shaders/cobblestone_surface.gdshader",
   "start_line": 1,
   "end_line": 5,
   "text": "shader_type spatial;\n\nuniform sampler2D color_tex : source_color, filter_linear_mipmap, repeat_enable;\nuniform sampler2D normal_tex : hint_normal, filter_linear_mipmap, repeat_enable;\nuniform sampler2D roughness_tex : filter_linear_mipmap, repeat_enable;"
  },
  {
   "beat_id": "B17",
   "path": "shaders/cobblestone_surface.gdshader",
   "start_line": 7,
   "end_line": 15,
   "text": "group_uniforms Surface;\nuniform vec4 tint : source_color = vec4(1.0, 1.0, 1.0, 1.0);\nuniform float uv_scale : hint_range(0.25, 4.0) = 1.0;\n\ngroup_uniforms Response;\nuniform float roughness_min : hint_range(0.0, 1.0) = 0.2;\nuniform float roughness_max : hint_range(0.0, 1.0) = 0.8;\nuniform float normal_strength : hint_range(0.0, 2.0) = 1.0;\ngroup_uniforms;"
  },
  {
   "beat_id": "B19",
   "path": "shaders/hint_experiment.gdshader",
   "start_line": 5,
   "end_line": 14,
   "text": "uniform sampler2D color_sample : source_color, filter_nearest;\nuniform sampler2D raw_sample : filter_nearest;\nuniform bool use_color = true;\n\nvoid fragment() {\n\tif (use_color) {\n\t\tALBEDO = texture(color_sample, UV).rgb;\n\t} else {\n\t\tALBEDO = texture(raw_sample, UV).rgb;\n\t}"
  },
  {
   "beat_id": "B21",
   "path": "shaders/standard_generated.gdshader",
   "start_line": 1,
   "end_line": 7,
   "text": "// NOTE: Shader automatically converted from Godot Engine 4.7.2.stable's StandardMaterial3D.\n\nshader_type spatial;\nrender_mode blend_mix, depth_draw_opaque, cull_back, diffuse_burley, specular_schlick_ggx;\n\nuniform vec4 albedo : source_color;\nuniform sampler2D texture_albedo : source_color, filter_linear_mipmap, repeat_enable;"
  },
