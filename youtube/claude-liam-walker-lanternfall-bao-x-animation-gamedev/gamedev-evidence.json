   ]
  },
  {
   "id": "dash-rig",
   "explanation": "The rig clip: head, arm, coat and legs as region rectangles of cell 2 under Hips, Chest and Neck pivots, keyed on Rig:position, Hips and Neck rotation at the phase boundaries 0/4/14/20 with transitions 2.0/1.0/0.5, built by a headless builder and saved with ResourceSaver; revision r2 adds Polygon2D outlines on the coat and legs from the cell's outer silhouette ring.",
   "beat_ids": [
    "B08",
    "B09",
    "B16",
    "B17"
   ],
   "files": [
    "features/player/build_courier_visual.gd",
