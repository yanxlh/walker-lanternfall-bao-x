   "path": "features/player/build_courier_visual.gd",
   "start_line": 45,
   "end_line": 53,
   "text": "## Dash phase table (ticks at 60 per second) and keys: [tick, value].\nconst DASH_STARTUP := 4\nconst DASH_ACTIVE := 10\nconst DASH_RECOVERY := 6\nconst DASH_TRACKS := {\n\t\"Rig:position\": [[0, Vector2(0, 0)], [3, Vector2(0, 1)], [4, Vector2(0, -1)], [14, Vector2(0, 0)], [16, Vector2(0, 1)], [20, Vector2(0, 0)]],\n\t\"Rig/Hips:rotation\": [[0, 0.0], [3, -0.15], [4, 0.35], [14, 0.30], [16, -0.08], [20, 0.0]],\n\t\"Rig/Hips/Chest/Neck:rotation\": [[0, 0.0], [3, 0.10], [4, -0.30], [10, -0.20], [14, -0.25], [16, 0.15], [18, -0.05], [20, 0.0]],\n}"
  },
  {
   "beat_id": "B10",
   "path": "features/player/player.gd",
   "start_line": 209,
   "end_line": 218,
   "text": "## The only place that drives the AnimationPlayer. It runs in manual mode, so the clip moves only when the\n## simulation ticks or an override is set; a frozen run freezes the courier.\nfunc _show() -> void:\n\tif anim == null:\n\t\treturn\n\tvisual.visible = sheet != null\n\tvisual.scale.x = facing\n\tvar shown := clip_and_time()\n\tanim.play(shown[0])\n\tanim.seek(shown[1], true)"
  },
  {
   "beat_id": "B12",
   "path": "features/player/player.gd",
   "start_line": 233,
   "end_line": 240,
   "text": "\t# Not invincible: the hit lands in every phase. It cancels startup (no dash happened, so no cooldown) and the\n\t# rest of recovery (the cooldown starts); an active dash carries on.\n\tmatch dash_phase:\n\t\t\"startup\":\n\t\t\t_set_dash_phase(\"\")\n\t\t\tdash_ticks = 0\n\t\t\"recovery\":\n\t\t\t_end_dash()"
  },
  {
   "beat_id": "B14",
   "path": "tests/test_courier_clips.gd",
   "start_line": 56,
   "end_line": 66,
   "text": "\t\t\t\t\tvar skeleton := node as Skeleton3D\n\t\t\t\t\tif skeleton == null or skeleton.find_bone(sub) == -1:\n\t\t\t\t\t\tproblems.append(\"%s track %d: no bone %s on %s\" % [clip_name, t, sub, node.name])\n\t\t\t\tAnimation.TYPE_BLEND_SHAPE:\n\t\t\t\t\tvar mesh := node as MeshInstance3D\n\t\t\t\t\tif mesh == null or mesh.find_blend_shape_by_name(sub) == -1:\n\t\t\t\t\t\tproblems.append(\"%s track %d: no blend shape %s on %s\" % [clip_name, t, sub, node.name])\n\t\t\t\t_:\n\t\t\t\t\tif not (sub in node):\n\t\t\t\t\t\tproblems.append(\"%s track %d: %s has no property %s\" % [clip_name, t, node.name, sub])\n\treturn problems"
  },
  {
   "beat_id": "B16",
